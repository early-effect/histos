#!/bin/sh
# Histos user install. One script: the installer and the command on PATH.
# It downloads a checksummed jar and, when the manifest has one, a native client.
# It does not install a JDK, Coursier, or clang.
set -eu
version=shim
fail() { echo "histos: $*" >&2; exit 1; }
hash_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}
valid_sha() { printf '%s\n' "$1" | awk 'length($0)==64 && $0 !~ /[^0-9a-fA-F]/ {ok=1} END {exit !ok}'; }
script_file() {
  file=$1
  [ -n "$file" ] && [ -f "$file" ] && grep -q 'Histos user install' "$file"
}
java_guide='A JDK 21 or newer is required. Histos does not install it.
macOS: brew install --cask temurin@21
Linux: https://adoptium.net/temurin/releases?version=21'
wsl_guide='Histos runs on macOS and Linux. On Windows, use WSL. A native Windows build may come later.'
clang_guide='clang is not on PATH. Histos does not install it.
macOS: brew install llvm
Linux: install clang from your distribution.'
home=${HISTOS_HOME:-$HOME/.histos}
# ChannelRefresh.Default is Ttl(1 hour). every-call is ChannelRefresh.EveryCall.
channel_ttl=3600
channel_refresh=ttl
case ${HISTOS_CHANNEL_REFRESH:-ttl} in
  ttl) channel_refresh=ttl ;;
  every-call) channel_refresh=every-call ;;
  *) fail "HISTOS_CHANNEL_REFRESH is ttl or every-call" ;;
esac
dist=${HISTOS_DIST:-https://github.com/early-effect/histos/releases/download/dist}
case $dist in
  https://*) ;;
  http://127.0.0.1|http://127.0.0.1/*|http://127.0.0.1:*|http://localhost|http://localhost/*|http://localhost:*) ;;
  *) fail "dist base is not a supported url: $dist" ;;
esac
os=$(uname -s)
case $os in
  MINGW*|MSYS*|CYGWIN*|Windows*) fail "$wsl_guide" ;;
esac
arch=$(uname -m)
case "$os-$arch" in
  Darwin-arm64) platform=macos-aarch64 ;;
  Darwin-x86_64) platform=macos-x86_64 ;;
  Linux-x86_64|Linux-amd64) platform=linux-x86_64 ;;
  Linux-aarch64|Linux-arm64) platform=linux-aarch64 ;;
  *) platform= ;;
esac
fetch() {
  url=$1
  dest=$2
  mkdir -p "$(dirname "$dest")"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest" || fail "could not fetch $url"
  else
    fail "curl is not on PATH"
  fi
}
json_string() {
  awk -v key="$2" '
    {
      line = $0
      gsub(/^[ \t]+/, "", line)
      needle = "\"" key "\""
      if (index(line, needle) == 1) {
        n = split(line, parts, "\"")
        if (n >= 4) { print parts[4]; exit }
      }
    }
  ' "$1"
}
check_java() {
  java_bin=$(command -v java) || fail "java is not on PATH
$java_guide"
  java_text=$("$java_bin" -version 2>&1 || true)
  if ! java_found=$(printf '%s\n' "$java_text" | awk '
    /version "/ {
      if (match($0, /"[^"]+"/)) {
        print substr($0, RSTART + 1, RLENGTH - 2)
        found = 1
        exit
      }
    }
    END { if (!found) exit 1 }
  '); then
    fail "java version is unreadable
$java_guide"
  fi
  java_major=$(printf '%s\n' "$java_found" | awk -F. '{ if ($1 == "1" && NF >= 2) print $2 + 0; else print $1 + 0 }')
  [ "$java_major" -ge 21 ] || fail "java $java_found is older than 21
$java_guide"
}
verify_sha() {
  file=$1
  expected=$2
  valid_sha "$expected" || fail "invalid checksum for $file"
  expected=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
  [ -f "$file" ] || fail "missing $file"
  [ "$(hash_of "$file")" = "$expected" ] || fail "checksum mismatch for $file"
}
mtime_of() {
  file=$1
  if stat -c %Y "$file" >/dev/null 2>&1; then
    stat -c %Y "$file"
  else
    stat -f %m "$file"
  fi
}
cached_channel() {
  file=$1
  [ "$channel_refresh" = ttl ] || return 1
  [ -f "$file" ] || return 1
  now=$(date +%s) || return 1
  then=$(mtime_of "$file") || return 1
  age=$((now - then))
  [ "$age" -ge 0 ] && [ "$age" -lt "$channel_ttl" ] || return 1
  resolved=$(tr -d '[:space:]' < "$file")
  [ -n "$resolved" ] || return 1
  printf '%s' "$resolved"
}
saved_channel() {
  file=$1
  [ -f "$file" ] || return 1
  resolved=$(tr -d '[:space:]' < "$file")
  [ -n "$resolved" ] || return 1
  printf '%s' "$resolved"
}
resolve_channel() {
  channel=$1
  case $channel in
    *-SNAPSHOT)
      cache=$home/channels/$channel
      if cached=$(cached_channel "$cache"); then
        printf '%s' "$cached"
        return 0
      fi
      tmp=$(mktemp)
      if fetch_ok "$dist/channel-$channel" "$tmp"; then
        resolved=$(tr -d '[:space:]' < "$tmp")
        rm -f "$tmp"
        if [ -n "$resolved" ]; then
          mkdir -p "$home/channels"
          printf '%s\n' "$resolved" > "$cache"
          printf '%s' "$resolved"
          return 0
        fi
      else
        rm -f "$tmp"
      fi
      if cached=$(saved_channel "$cache"); then
        printf '%s' "$cached"
        return 0
      fi
      fail "channel $channel did not resolve"
      ;;
    *) printf '%s' "$channel" ;;
  esac
}
fetch_ok() {
  curl -fsSL "$1" -o "$2" 2>/dev/null
}
read_default() {
  if [ -s "$home/default" ]; then
    tr -d '[:space:]' < "$home/default"
  else
    return 1
  fi
}
write_default() {
  printf '%s\n' "$1" > "$home/default"
}
pick_channel() {
  awk '
    function num(v, a, n) {
      n = split(v, a, ".")
      if (n != 3) return -1
      if (a[1] !~ /^[0-9]+$/ || a[2] !~ /^[0-9]+$/ || a[3] !~ /^[0-9]+$/) return -1
      return a[1] * 1000000 + a[2] * 1000 + a[3]
    }
    function consider(name, ver, r) {
      if (name ~ /^channel-[0-9]+\.[0-9]+\.[0-9]+-SNAPSHOT$/) {
        ver = substr(name, 9)
        r = num(substr(ver, 1, length(ver) - 9))
        if (r > snap_rank) { snap_rank = r; snap = ver }
      } else if (name ~ /^[0-9]+\.[0-9]+\.[0-9]+-manifest\.json$/) {
        ver = substr(name, 1, length(name) - 14)
        r = num(ver)
        if (r > rel_rank) { rel_rank = r; rel = ver }
      }
    }
    BEGIN { snap_rank = -1; rel_rank = -1 }
    { consider($0) }
    END {
      if (snap != "") print snap
      else if (rel != "") print rel
      else exit 1
    }
  '
}
asset_names() {
  awk '
    {
      line = $0
      while (match(line, /"name"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
        token = substr(line, RSTART, RLENGTH)
        split(token, q, "\"")
        print q[4]
        line = substr(line, RSTART + RLENGTH)
      }
    }
  ' "$1"
}
published_channel() {
  tmp=$(mktemp)
  names=$(mktemp)
  if fetch_ok "$dist/channel" "$tmp"; then
    channel=$(tr -d '[:space:]' < "$tmp")
    if [ -n "$channel" ]; then
      rm -f "$tmp" "$names"
      printf '%s' "$channel"
      return 0
    fi
  fi
  case $dist in
    https://github.com/*/releases/download/*)
      owner_repo=${dist#https://github.com/}
      owner_repo=${owner_repo%%/releases/download/*}
      tag=${dist##*/}
      if fetch_ok "https://api.github.com/repos/$owner_repo/releases/tags/$tag" "$tmp"; then
        asset_names "$tmp" > "$names"
        if channel=$(pick_channel < "$names"); then
          rm -f "$tmp" "$names"
          printf '%s' "$channel"
          return 0
        fi
      fi
      ;;
  esac
  if fetch_ok "$dist/assets" "$tmp"; then
    if channel=$(pick_channel < "$tmp"); then
      rm -f "$tmp" "$names"
      printf '%s' "$channel"
      return 0
    fi
  fi
  rm -f "$tmp" "$names"
  return 1
}
no_default() {
  fail "no default toolchain. Run 'histos toolchain install <version>'"
}
find_repo() {
  dir=$PWD
  while :; do
    if [ -f "$dir/build.properties" ] || [ -f "$dir/.histos/assembly.sha256" ]; then
      printf '%s' "$dir"
      return 0
    fi
    parent=$(dirname "$dir")
    [ "$parent" = "$dir" ] && return 1
    dir=$parent
  done
}
read_pin() {
  props=$1/build.properties
  [ -f "$props" ] || return 1
  awk '
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    {
      eq = index($0, "=")
      if (eq <= 1) exit 1
      key = substr($0, 1, eq - 1)
      value = substr($0, eq + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      if (key == "histos.version" && value != "") { print value; found = 1; exit }
    }
    END { if (!found) exit 1 }
  ' "$props"
}
write_pin() {
  props=$2/build.properties
  if [ -f "$props" ]; then
    awk -v version="$1" '
      BEGIN { done = 0 }
      /^[ \t]*histos\.version[ \t]*=/ { print "histos.version=" version; done = 1; next }
      { print }
      END { if (!done) print "histos.version=" version }
    ' "$props" > "$props.next"
    mv "$props.next" "$props"
  else
    printf 'histos.version=%s\n' "$1" > "$props"
  fi
}
local_jar() {
  repo=$1
  if [ -n "${HISTOS_ASSEMBLY:-}" ]; then
    printf '%s' "$HISTOS_ASSEMBLY"
    return 0
  fi
  if [ -f "$repo/dist/histos.jar" ]; then
    printf '%s' "$repo/dist/histos.jar"
    return 0
  fi
  return 1
}
assembly_ok() {
  repo=$1
  jar=$2
  expected=$(tr -d '[:space:]' < "$repo/.histos/assembly.sha256")
  verify_sha "$jar" "$expected"
}
ensure_toolchain() {
  selected=$1
  compile_client=$2
  dir=$home/toolchains/$selected
  mkdir -p "$dir"
  manifest=$dir/manifest.json
  fetch "$dist/$selected-manifest.json" "$manifest"
  [ "$(json_string "$manifest" version)" = "$selected" ] || fail "manifest version is not $selected"
  jar_name=$(json_string "$manifest" jar)
  jar_sha=$(json_string "$manifest" jarSha256)
  [ -n "$jar_name" ] && [ -n "$jar_sha" ] || fail "manifest has no jar"
  jar=$dir/histos.jar
  fetch "$dist/$jar_name" "$jar"
  verify_sha "$jar" "$jar_sha"
  client=$dir/histos-client
  origin=$dir/client.origin
  if [ "$compile_client" = yes ]; then
    command -v clang >/dev/null 2>&1 || fail "$clang_guide"
    sources_sha=$(json_string "$manifest" sourcesSha256)
    [ -n "$sources_sha" ] || fail "this version has no client sources"
    archive=$dir/sources.tar
    fetch "$dist/$selected-sources.tar" "$archive"
    verify_sha "$archive" "$sources_sha"
    work=$(mktemp -d)
    tar -xf "$archive" -C "$work"
    check_java
    ( cd "$work" && "$java_bin" --enable-native-access=ALL-UNNAMED -jar "$jar" client ) || fail "client compile failed"
    [ -f "$work/dist/histos-client" ] || fail "client compile did not write a binary"
    cp "$work/dist/histos-client" "$client"
    chmod +x "$client"
    printf 'local\n' > "$origin"
    rm -rf "$work"
  elif [ -n "$platform" ] && client_sha=$(json_string "$manifest" "$platform") && [ -n "$client_sha" ]; then
    fetched=$dir/histos-client.download
    fetch "$dist/$selected-client-$platform" "$fetched"
    verify_sha "$fetched" "$client_sha"
    mv "$fetched" "$client"
    chmod +x "$client"
    printf 'prebuilt\n' > "$origin"
  else
    if [ ! -x "$client" ]; then
      echo "histos: no prebuilt client for ${platform:-this platform}. java -jar will run. --compile-client links one when clang is available." >&2
      rm -f "$client" "$origin"
    fi
  fi
}
exec_jar() {
  jar=$1
  repo=$2
  shift 2
  check_java
  client=
  if [ -n "$repo" ] && [ -x "$repo/dist/histos-client" ] && [ "$jar" = "$repo/dist/histos.jar" ]; then
    client=$repo/dist/histos-client
  fi
  tool=$(dirname "$jar")
  if [ -z "$client" ] && [ -x "$tool/histos-client" ]; then client=$tool/histos-client; fi
  use_jar=1
  if [ "$#" -ge 1 ]; then
    case $1 in
      server|bsp|mcp) use_jar=1 ;;
      *) [ -n "$client" ] && use_jar=0 ;;
    esac
  fi
  HISTOS_JAVA=$java_bin
  HISTOS_JAR=$jar
  HISTOS_VERSION="histos $version"
  export HISTOS_JAVA HISTOS_JAR HISTOS_VERSION
  if [ -n "$repo" ]; then HISTOS_ROOT=$repo; export HISTOS_ROOT; fi
  if [ "$use_jar" -eq 0 ]; then exec "$client" "$@"; fi
  jvm_extra=
  if [ -n "$repo" ] && [ -f "$repo/.jvmopts" ]; then
    while IFS= read -r opt || [ -n "$opt" ]; do
      opt=${opt%$(printf '\r')}
      case $opt in
        ''|\#*) continue ;;
        -jar|-m|--module) fail "jvm option selects the program: $opt" ;;
        @*) fail "jvm option selects the program: $opt" ;;
      esac
      jvm_extra="$jvm_extra $(printf '%s' "$opt" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/")"
    done < "$repo/.jvmopts"
  fi
  # shellcheck disable=SC2086
  eval "set -- $jvm_extra --enable-native-access=ALL-UNNAMED -jar $(printf '%s' "$jar" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/") $(for one in "$@"; do printf '%s' "$one" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/"; printf ' '; done)"
  exec "$java_bin" "$@"
}
installed=$home/bin/histos
self=$0
case $self in
  */*) ;;
  *) self=$(command -v "$self" || printf '%s' "$self") ;;
esac
if [ -f "$self" ]; then
  self_dir=$(CDPATH= cd -- "$(dirname "$self")" && pwd)
  self_path=$self_dir/$(basename "$self")
else
  self_path=
fi
# A PATH symlink to the installed shim is the same file. cp then fails with "are the same file".
if [ "$self_path" != "$installed" ] && { [ -z "$self_path" ] || [ ! -e "$installed" ] || [ ! "$self_path" -ef "$installed" ]; }; then
  mkdir -p "$home/bin"
  if script_file "$self_path"; then
    cp "$self_path" "$installed"
    chmod +x "$installed"
  else
    tmp=$(mktemp)
    fetch "$dist/shim.sha256" "$tmp"
    expected=$(tr -d '[:space:]' < "$tmp")
    rm -f "$tmp"
    fetch "$dist/shim" "$installed"
    verify_sha "$installed" "$expected"
    chmod +x "$installed"
  fi
  if [ "$#" -eq 0 ]; then
    if [ ! -s "$home/default" ]; then
      channel=$(published_channel) || no_default
      write_default "$channel"
    fi
    echo "export PATH=\"\$HOME/.histos/bin:\$PATH\""
    exit 0
  fi
  exec "$installed" "$@"
fi
cmd=${1:-}
case $cmd in
  self)
    shift
    sub=${1:-}
    [ "$sub" = update ] || fail "unknown command 'self ${sub:-}'
did you mean self update?
histos help
histos help self"
    tmp=$(mktemp)
    fetch "$dist/shim.sha256" "$tmp"
    expected=$(tr -d '[:space:]' < "$tmp")
    rm -f "$tmp"
    current=$(hash_of "$installed")
    want=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
    if [ "$current" = "$want" ]; then exit 0; fi
    next=$home/bin/histos.next
    fetch "$dist/shim" "$next"
    verify_sha "$next" "$expected"
    chmod +x "$next"
    mv "$next" "$installed"
    exit 0
    ;;
  toolchain)
    shift
    sub=${1:-}
    case $sub in
      list)
        if [ -d "$home/toolchains" ]; then
          find "$home/toolchains" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
        fi
        exit 0
        ;;
      install)
        shift
        selected=${1:-}
        [ -n "$selected" ] || fail "usage: histos toolchain install <version>"
        shift || true
        compile=no
        for flag in "$@"; do
          [ "$flag" = --compile-client ] && compile=yes
        done
        channel_refresh=every-call
        selected=$(resolve_channel "$selected")
        ensure_toolchain "$selected" "$compile"
        if [ ! -s "$home/default" ]; then write_default "$selected"; fi
        exit 0
        ;;
      *) fail "unknown command 'toolchain ${sub:-}'
histos toolchain install <version>
histos toolchain list
histos help toolchain" ;;
    esac
    ;;
  update)
    shift
    make_default=no
    compile=no
    for flag in "$@"; do
      case $flag in
        --make-default) make_default=yes ;;
        --compile-client) compile=yes ;;
        *) fail "unknown update flag: $flag" ;;
      esac
    done
    channel_refresh=every-call
    repo=$(find_repo || true)
    if [ -n "$repo" ] && pin=$(read_pin "$repo"); then
      selected=$(resolve_channel "$pin")
      write_pin "$selected" "$repo"
      if [ "$make_default" = yes ]; then printf '%s\n' "$selected" > "$home/default"; fi
    else
      current=$(read_default || true)
      if [ -z "$current" ]; then
        current=$(published_channel) || no_default
      fi
      selected=$(resolve_channel "$current")
      write_default "$selected"
    fi
    ensure_toolchain "$selected" "$compile"
    exit 0
    ;;
esac
repo=$(find_repo || true)
if [ -n "$repo" ] && jar=$(local_jar "$repo"); then
  assembly_ok "$repo" "$jar"
  version=$(read_pin "$repo" || printf '%s' local)
  exec_jar "$jar" "$repo" "$@"
fi
if [ -n "$repo" ] && pin=$(read_pin "$repo"); then
  selected=$(resolve_channel "$pin")
else
  current=$(read_default || true)
  if [ -z "$current" ]; then
    current=$(published_channel) || no_default
    write_default "$current"
  fi
  selected=$(resolve_channel "$current")
fi
version=$selected
dir=$home/toolchains/$selected
if [ ! -f "$dir/histos.jar" ]; then ensure_toolchain "$selected" no; fi
exec_jar "$dir/histos.jar" "$repo" "$@"
