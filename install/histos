#!/bin/sh
# Histos user install. One script: the installer and the command on PATH.
# A manifest that names a jar downloads that jar. A manifest that names a Maven
# coordinate resolves it and packs the toolchain jar on this machine.
# It does not install a JDK, the cs binary, or clang. A native client is optional and built on this machine.
set -eu
version=shim
fail() { echo "histos: $*" >&2; exit 1; }
# HISTOS_PIN is the toolchain id for this process. It does not change histos.version.
# Empty means this command resolves the pin. A bad id fails. update does not call this.
use_pin() {
  case ${HISTOS_PIN:-} in
    "") return 1 ;;
    .*|*/*|*\\*|*[[:space:]]*) fail "HISTOS_PIN is not one path segment" ;;
  esac
  jar=$home/toolchains/$HISTOS_PIN/histos.jar
  [ -f "$jar" ] || fail "HISTOS_PIN $HISTOS_PIN is not installed"
  version=$HISTOS_PIN
  return 0
}
hash_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}
valid_sha() { printf '%s\n' "$1" | awk 'length($0)==64 && $0 !~ /[^0-9a-fA-F]/ {ok=1} END {exit !ok}'; }
script_file() {
  file=$1
  [ -n "$file" ] && [ -f "$file" ] && grep -q 'Histos user install' "$file"
}
java_guide='A JDK 25 or newer is required. Histos does not install it.
macOS: brew install --cask temurin@25
Linux: https://adoptium.net/temurin/releases?version=25'
wsl_guide='Histos runs on macOS and Linux. On Windows, use WSL. A native Windows build may come later.'
home=${HISTOS_HOME:-$HOME/.histos}
stable=no
# ChannelRefresh.Default is Ttl(1 hour). every-call is ChannelRefresh.EveryCall.
channel_ttl=3600
channel_refresh=ttl
case ${HISTOS_CHANNEL_REFRESH:-ttl} in
  ttl) channel_refresh=ttl ;;
  every-call) channel_refresh=every-call ;;
  *) fail "HISTOS_CHANNEL_REFRESH is ttl or every-call" ;;
esac
dist=${HISTOS_DIST:-https://github.com/early-effect/histos/releases/download/dist}
case $dist in
  https://*) ;;
  http://127.0.0.1|http://127.0.0.1/*|http://127.0.0.1:*|http://localhost|http://localhost/*|http://localhost:*) ;;
  *) fail "dist base is not a supported url: $dist" ;;
esac
# The runnable Coursier CLI. Central's coursier-cli module jar is not a java -jar.
coursier_url=https://github.com/coursier/coursier/releases/download/v2.1.24/coursier.jar
coursier_sha=8c724dc204534353ea8263ba0af624979658f7ab62395f35b04f03ce5714f330
snapshots_repo=https://central.sonatype.com/repository/maven-snapshots
os=$(uname -s)
case $os in
  MINGW*|MSYS*|CYGWIN*|Windows*) fail "$wsl_guide" ;;
esac
# Names here are globals. Callers keep dest across this return, so these cannot be url or dest.
# One attempt. 0 is a body. 1 is a failure that is not retried. 2 is 429 or 503, and $wait_for is the pause.
attempt_fetch() {
  attempt_url=$1
  attempt_dest=$2
  headers=$(mktemp)
  code=$(curl -sS -L -D "$headers" -o "$attempt_dest" -w '%{http_code}' "$attempt_url" || printf '000')
  case $code in
    2??) rm -f "$headers"; return 0 ;;
    429|503)
      wait_for=$(awk 'tolower($1)=="retry-after:" && $2 ~ /^[0-9]+$/ { print $2; exit }' "$headers")
      rm -f "$headers"
      return 2
      ;;
    *)
      rm -f "$headers"
      return 1
      ;;
  esac
}
# 429 and 503 are retried. Retry-After in seconds is the wait, capped at 60. Five attempts, then the failure.
retry_fetch() {
  retry_url=$1
  retry_dest=$2
  command -v curl >/dev/null 2>&1 || return 1
  attempt=1
  while [ "$attempt" -le 5 ]; do
    attempt_fetch "$retry_url" "$retry_dest"
    status=$?
    case $status in
      0) return 0 ;;
      2)
        [ "$attempt" -eq 5 ] && break
        if [ -z "$wait_for" ]; then wait_for=$((2 ** (attempt - 1))); fi
        [ "$wait_for" -gt 60 ] && wait_for=60
        sleep "$wait_for"
        ;;
      *) return 1 ;;
    esac
    attempt=$((attempt + 1))
  done
  return 1
}
fetch() {
  fetch_url=$1
  fetch_dest=$2
  mkdir -p "$(dirname "$fetch_dest")"
  retry_fetch "$fetch_url" "$fetch_dest" || fail "could not fetch $fetch_url"
}
json_string() {
  awk -v key="$2" '
    {
      line = $0
      gsub(/^[ \t]+/, "", line)
      needle = "\"" key "\""
      if (index(line, needle) == 1) {
        n = split(line, parts, "\"")
        if (n >= 4) { print parts[4]; exit }
      }
    }
  ' "$1"
}
# dist: a published jar name and checksum. coordinate: a Maven module to pack here. missing: neither.
manifest_kind() {
  file=$1
  [ -f "$file" ] || fail "no manifest at $file"
  jar_name=$(json_string "$file" jar)
  jar_sha=$(json_string "$file" jarSha256)
  group=$(json_string "$file" group)
  artifact=$(json_string "$file" artifact)
  revision=$(json_string "$file" revision)
  if [ -n "$jar_name" ] && [ -n "$jar_sha" ]; then
    printf 'dist'
  elif [ -n "$group" ] && [ -n "$artifact" ] && [ -n "$revision" ]; then
    printf 'coordinate'
  else
    printf 'missing'
  fi
}
# Dry run of manifest_kind. No JDK, no fetch, no install.
if [ "${1:-}" = --manifest-kind ]; then
  [ "$#" -eq 2 ] || fail "usage: histos --manifest-kind <manifest>"
  manifest_kind "$2"
  printf '\n'
  exit 0
fi
check_java() {
  java_bin=$(command -v java) || fail "java is not on PATH
$java_guide"
  java_text=$("$java_bin" -version 2>&1 || true)
  if ! java_found=$(printf '%s\n' "$java_text" | awk '
    /version "/ {
      if (match($0, /"[^"]+"/)) {
        print substr($0, RSTART + 1, RLENGTH - 2)
        found = 1
        exit
      }
    }
    END { if (!found) exit 1 }
  '); then
    fail "java version is unreadable
$java_guide"
  fi
  java_major=$(printf '%s\n' "$java_found" | awk -F. '{ if ($1 == "1" && NF >= 2) print $2 + 0; else print $1 + 0 }')
  [ "$java_major" -ge 25 ] || fail "java $java_found is older than 25
$java_guide"
}
verify_sha() {
  file=$1
  expected=$2
  valid_sha "$expected" || fail "invalid checksum for $file"
  [ -f "$file" ] || fail "missing $file"
  sha_matches "$file" "$expected" || fail "checksum mismatch for $file"
}
sha_matches() {
  [ "$(hash_of "$1")" = "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ]
}
mtime_of() {
  file=$1
  if stat -c %Y "$file" >/dev/null 2>&1; then
    stat -c %Y "$file"
  else
    stat -f %m "$file"
  fi
}
cached_channel() {
  file=$1
  [ "$channel_refresh" = ttl ] || return 1
  [ -f "$file" ] || return 1
  now=$(date +%s) || return 1
  then=$(mtime_of "$file") || return 1
  age=$((now - then))
  [ "$age" -ge 0 ] && [ "$age" -lt "$channel_ttl" ] || return 1
  resolved=$(tr -d '[:space:]' < "$file")
  [ -n "$resolved" ] || return 1
  printf '%s' "$resolved"
}
saved_channel() {
  file=$1
  [ -f "$file" ] || return 1
  resolved=$(tr -d '[:space:]' < "$file")
  [ -n "$resolved" ] || return 1
  printf '%s' "$resolved"
}
resolve_channel() {
  channel=$1
  # Local assets already name one toolchain. There is no channel file to fetch.
  if [ -n "${HISTOS_ASSETS:-}" ]; then
    printf '%s' "$channel"
    return 0
  fi
  case $channel in
    *-SNAPSHOT)
      cache=$home/channels/$channel
      if cached=$(cached_channel "$cache"); then
        printf '%s' "$cached"
        return 0
      fi
      tmp=$(mktemp)
      if fetch_ok "$dist/channel-$channel" "$tmp"; then
        resolved=$(tr -d '[:space:]' < "$tmp")
        rm -f "$tmp"
        if [ -n "$resolved" ]; then
          mkdir -p "$home/channels"
          printf '%s\n' "$resolved" > "$cache"
          printf '%s' "$resolved"
          return 0
        fi
      else
        rm -f "$tmp"
      fi
      if cached=$(saved_channel "$cache"); then
        printf '%s' "$cached"
        return 0
      fi
      fail "channel $channel did not resolve"
      ;;
    *) printf '%s' "$channel" ;;
  esac
}
fetch_ok() {
  command -v curl >/dev/null 2>&1 || return 1
  retry_fetch "$1" "$2"
}
read_default() {
  if [ -s "$home/default" ]; then
    tr -d '[:space:]' < "$home/default"
  else
    return 1
  fi
}
write_default() {
  printf '%s\n' "$1" > "$home/default"
}
# The newest `release` (X.Y.Z) or `snapshot` pointer (X.Y.Z-SNAPSHOT) among asset names on stdin, at or above the
# X.Y.Z in $2. An empty floor takes any. Fails when none qualifies.
newest() {
  awk -v kind="$1" -v floor_version="${2:-}" '
    function num(v, a, n) {
      n = split(v, a, ".")
      if (n != 3) return -1
      if (a[1] !~ /^[0-9]+$/ || a[2] !~ /^[0-9]+$/ || a[3] !~ /^[0-9]+$/) return -1
      return a[1] * 1000000 + a[2] * 1000 + a[3]
    }
    BEGIN { floor = num(floor_version); best = -1 }
    {
      if (kind == "snapshot" && $0 ~ /^channel-[0-9]+\.[0-9]+\.[0-9]+-SNAPSHOT$/) {
        ver = substr($0, 9)
        r = num(substr(ver, 1, length(ver) - 9))
      } else if (kind == "release" && $0 ~ /^[0-9]+\.[0-9]+\.[0-9]+-manifest\.json$/) {
        ver = substr($0, 1, length($0) - 14)
        r = num(ver)
      } else next
      if (r >= floor && r > best) { best = r; pick = ver }
    }
    END { if (pick == "") exit 1; print pick }
  '
}
# The X.Y.Z a snapshot pin belongs to. A commit pin and a timestamp pin keep that number.
# A release is not a snapshot line.
snapshot_line() {
  printf '%s\n' "$1" | awk '
    {
      if (match($0, /^[0-9]+\.[0-9]+\.[0-9]+-/))
        print substr($0, RSTART, RLENGTH - 1)
      else exit 1
    }
  '
}
# One fetch, with the retry. No JDK.
if [ "${1:-}" = --fetch ]; then
  [ "$#" -eq 3 ] || fail "usage: histos --fetch <url> <dest>"
  fetch "$2" "$3"
  exit 0
fi
# Dry run of the update line. No JDK, no fetch.
if [ "${1:-}" = --snapshot-line ]; then
  [ "$#" -eq 2 ] || fail "usage: histos --snapshot-line <pin>"
  snapshot_line "$2"
  exit 0
fi
if [ "${1:-}" = --newest ]; then
  [ "$#" -eq 3 ] || fail "usage: histos --newest <release|snapshot> <floor>"
  newest "$2" "$3"
  exit 0
fi
asset_names() {
  awk '
    {
      line = $0
      while (match(line, /"name"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
        token = substr(line, RSTART, RLENGTH)
        split(token, q, "\"")
        print q[4]
        line = substr(line, RSTART + RLENGTH)
      }
    }
  ' "$1"
}
# Asset names on the dist base, one per line. A GitHub release lists its own. Any other base serves `assets`.
dist_assets() {
  listing=$(mktemp)
  listed=no
  case $dist in
    https://github.com/*/releases/download/*)
      owner_repo=${dist#https://github.com/}
      owner_repo=${owner_repo%%/releases/download/*}
      if fetch_ok "https://api.github.com/repos/$owner_repo/releases/tags/${dist##*/}" "$listing"; then
        asset_names "$listing"
        listed=yes
      fi
      ;;
  esac
  if [ "$listed" = no ] && fetch_ok "$dist/assets" "$listing"; then
    cat "$listing"
    listed=yes
  fi
  rm -f "$listing"
  [ "$listed" = yes ]
}
# The default is the latest stable release. A snapshot pointer is used only when dist has no release.
# An explicit channel asset wins over both.
published_channel() {
  tmp=$(mktemp)
  if fetch_ok "$dist/channel" "$tmp"; then
    channel=$(tr -d '[:space:]' < "$tmp")
    if [ -n "$channel" ]; then
      rm -f "$tmp"
      printf '%s' "$channel"
      return 0
    fi
  fi
  if dist_assets > "$tmp" && { channel=$(newest release < "$tmp") || channel=$(newest snapshot < "$tmp"); }; then
    rm -f "$tmp"
    printf '%s' "$channel"
    return 0
  fi
  rm -f "$tmp"
  return 1
}
# Yes when --stable was passed or the terminal answers y. Without a terminal, prints how to switch.
take_stable() {
  release=$1
  pin=$2
  [ "$stable" = yes ] && return 0
  if [ -t 0 ] && [ -t 2 ] && { [ -z "${CI:-}" ] || [ "${CI:-}" = false ]; }; then
    printf 'histos %s is a stable release. Switch from %s to %s? [y/N] ' "$release" "$pin" "$release" >&2
    answer=
    read -r answer < /dev/tty || answer=
    case $answer in
      y|Y|yes|Yes|YES) return 0 ;;
      *) return 1 ;;
    esac
  fi
  echo "histos $release is a stable release. histos update --stable switches." >&2
  return 1
}
# Sets `next`, the pin `update` writes for $1. A release moves to the newest release. A snapshot moves to the newest
# line at or above its own and keeps its form unless `form` is freeze or follow. A release at or above that line is
# offered first.
next_pin() {
  pin=$1
  names=$(mktemp)
  dist_assets > "$names" || echo "histos: $dist does not list its assets. update keeps the line of $pin." >&2
  if ! line=$(snapshot_line "$pin"); then
    next=$(newest release "$pin" < "$names" || printf '%s' "$pin")
    rm -f "$names"
    return 0
  fi
  pointer=$(newest snapshot "$line" < "$names" || printf '%s-SNAPSHOT' "$line")
  offer=$(newest release "$line" < "$names" || true)
  rm -f "$names"
  if [ -n "$offer" ] && take_stable "$offer" "$pin"; then
    next=$offer
    return 0
  fi
  if [ "$form" = keep ]; then
    case $pin in
      *-SNAPSHOT) form=follow ;;
      *) form=freeze ;;
    esac
  fi
  case $form in
    follow) next=$pointer ;;
    freeze) next=$(resolve_channel "$pointer") ;;
  esac
}
no_default() {
  fail "no default toolchain. Run 'histos toolchain install <version>'"
}
find_repo() {
  dir=$PWD
  while :; do
    if [ -f "$dir/build.properties" ]; then
      printf '%s' "$dir"
      return 0
    fi
    parent=$(dirname "$dir")
    [ "$parent" = "$dir" ] && return 1
    dir=$parent
  done
}
read_pin() {
  props=$1/build.properties
  [ -f "$props" ] || return 1
  awk '
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    {
      eq = index($0, "=")
      if (eq <= 1) exit 1
      key = substr($0, 1, eq - 1)
      value = substr($0, eq + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      if (key == "histos.version" && value != "") { print value; found = 1; exit }
    }
    END { if (!found) exit 1 }
  ' "$props"
}
write_pin() {
  props=$2/build.properties
  if [ -f "$props" ]; then
    awk -v version="$1" '
      BEGIN { done = 0 }
      /^[ \t]*histos\.version[ \t]*=/ { print "histos.version=" version; done = 1; next }
      { print }
      END { if (!done) print "histos.version=" version }
    ' "$props" > "$props.next"
    mv "$props.next" "$props"
  else
    printf 'histos.version=%s\n' "$1" > "$props"
  fi
}
ci_set() {
  [ -n "${CI:-}" ] && [ "${CI}" != "false" ]
}
stamp_matches() {
  tool=$1
  jar=$2
  [ -f "$tool/client.stamp" ] || return 1
  want=$(tr -d '[:space:]' < "$tool/client.stamp")
  got=$(hash_of "$jar")
  [ "$want" = "$got" ]
}
copy_asset() {
  name=$1
  dest=$2
  src=${HISTOS_ASSETS}/$name
  [ -f "$src" ] || fail "no $name under HISTOS_ASSETS. publish local writes dist/install"
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
}
place_manifest() {
  selected=$1
  dest=$2
  if [ -n "${HISTOS_ASSETS:-}" ]; then
    copy_asset manifest.json "$dest"
  else
    fetch "$dist/$selected-manifest.json" "$dest"
  fi
}
place_jar() {
  manifest=$1
  dest=$2
  if [ -n "${HISTOS_ASSETS:-}" ]; then
    org=$(json_string "$manifest" ivyOrganisation)
    module=$(json_string "$manifest" ivyModule)
    rev=$(json_string "$manifest" ivyRevision)
    [ -n "$org" ] && [ -n "$module" ] && [ -n "$rev" ] || fail "local manifest has no ivy coordinate. publish local first"
    ivy=${HISTOS_IVY:-$HOME/.ivy2/local}
    src=$ivy/$org/$module/$rev/jars/$module.jar
    [ -f "$src" ] || fail "no jar at $src. publish local first"
    cp "$src" "$dest"
  else
    name=$(json_string "$manifest" jar)
    [ -n "$name" ] || fail "manifest has no jar"
    fetch "$dist/$name" "$dest"
  fi
}
# A missing kit does not fail install. The jar still runs.
place_kit() {
  manifest=$1
  dest=$2
  name=$(json_string "$manifest" clientKit)
  [ -n "$name" ] || return 0
  sha=$(json_string "$manifest" clientKitSha256)
  [ -n "$sha" ] || return 0
  if [ -f "$dest" ] && ! sha_matches "$dest" "$sha"; then rm -f "$dest"; fi
  if [ ! -f "$dest" ]; then
    if [ -n "${HISTOS_ASSETS:-}" ]; then
      src=${HISTOS_ASSETS}/$name
      if [ ! -f "$src" ]; then
        echo "histos: no client kit under HISTOS_ASSETS. histos toolchain client builds one after publish local." >&2
        return 0
      fi
      cp "$src" "$dest"
    elif ! fetch_ok "$dist/$name" "$dest"; then
      echo "histos: could not fetch the client kit. java -jar will run." >&2
      rm -f "$dest"
      return 0
    fi
  fi
  if ! sha_matches "$dest" "$sha"; then
    echo "histos: client kit checksum did not match. java -jar will run." >&2
    rm -f "$dest"
  fi
}
# A toolchain is ready when its jar and manifest are on disk. The client is optional.
toolchain_ready() {
  dir=$home/toolchains/$1
  [ -f "$dir/histos.jar" ] && [ -f "$dir/manifest.json" ]
}
# True when both manifests name the same jar or the same Maven coordinate.
same_pin() {
  left=$1
  right=$2
  [ "$(json_string "$left" group)" = "$(json_string "$right" group)" ] \
    && [ "$(json_string "$left" artifact)" = "$(json_string "$right" artifact)" ] \
    && [ "$(json_string "$left" revision)" = "$(json_string "$right" revision)" ] \
    && [ "$(json_string "$left" ivyOrganisation)" = "$(json_string "$right" ivyOrganisation)" ] \
    && [ "$(json_string "$left" ivyModule)" = "$(json_string "$right" ivyModule)" ] \
    && [ "$(json_string "$left" ivyRevision)" = "$(json_string "$right" ivyRevision)" ] \
    && [ "$(json_string "$left" jar)" = "$(json_string "$right" jar)" ] \
    && [ "$(json_string "$left" jarSha256)" = "$(json_string "$right" jarSha256)" ]
}
# A release revision is major.minor.patch. Anything else is fetched as a snapshot.
release_revision() {
  printf '%s\n' "$1" | awk '/^[0-9]+\.[0-9]+\.[0-9]+$/ { ok = 1 } END { exit !ok }'
}
ensure_coursier() {
  dest=$home/coursier.jar
  if [ -f "$dest" ] && sha_matches "$dest" "$coursier_sha"; then
    return 0
  fi
  tmp=$(mktemp)
  fetch "$coursier_url" "$tmp" || { rm -f "$tmp"; fail "could not fetch the coursier cli"; }
  verify_sha "$tmp" "$coursier_sha"
  mv "$tmp" "$dest"
}
coursier_repositories() {
  manifest=$1
  revision=$2
  args=
  if [ -n "$(json_string "$manifest" ivyOrganisation)" ]; then
    args="-r ivy2local"
  fi
  args="$args -r central"
  if ! release_revision "$revision"; then
    args="$args -r $snapshots_repo"
  fi
  printf '%s' "$args"
}
pack_repositories() {
  manifest=$1
  revision=$2
  pack_repos=
  if [ -n "$(json_string "$manifest" ivyOrganisation)" ]; then
    pack_repos="--repository ivy-local"
  fi
  pack_repos="$pack_repos --repository central"
  if ! release_revision "$revision"; then
    pack_repos="$pack_repos --repository maven:$snapshots_repo"
  fi
}
fetch_classpath() {
  manifest=$1
  group=$2
  artifact=$3
  revision=$4
  repos=$(coursier_repositories "$manifest" "$revision")
  # Default coursier also searches ~/.ivy2/local, so a local publish of this snapshot hides the channel.
  # A snapshot TTL would keep a sibling module from an earlier publish.
  ttl=
  if ! release_revision "$revision"; then ttl="--ttl 0"; fi
  # shellcheck disable=SC2086
  # A 429 is waited out inside this one JVM. The cap is the longest this fetch spends being told to come back.
  COURSIER_MAX_THROTTLE_WAIT=10min \
    "$java_bin" -jar "$home/coursier.jar" fetch --no-default -q -p $ttl $repos "$group:$artifact:$revision"
}
install_dist_jar() {
  manifest=$1
  dir=$2
  jar_sha=$(json_string "$manifest" jarSha256)
  [ -n "$(json_string "$manifest" jar)" ] && [ -n "$jar_sha" ] || fail "manifest has no jar"
  jar=$dir/histos.jar
  if [ -f "$jar" ] && ! sha_matches "$jar" "$jar_sha"; then rm -f "$jar"; fi
  [ -f "$jar" ] || place_jar "$manifest" "$jar"
  verify_sha "$jar" "$jar_sha"
}
install_coordinate() {
  manifest=$1
  dir=$2
  group=$(json_string "$manifest" group)
  artifact=$(json_string "$manifest" artifact)
  revision=$(json_string "$manifest" revision)
  [ -n "$group" ] && [ -n "$artifact" ] && [ -n "$revision" ] || fail "manifest has no coordinate"
  jar=$dir/histos.jar
  # The packed jar is this machine's. A coordinate change deletes it before this runs.
  [ -f "$jar" ] && return 0
  check_java
  ensure_coursier
  cp=$(fetch_classpath "$manifest" "$group" "$artifact" "$revision") || fail "could not resolve $group:$artifact:$revision"
  [ -n "$cp" ] || fail "could not resolve $group:$artifact:$revision"
  pack_repositories "$manifest" "$revision"
  echo "packing $group:$artifact:$revision" >&2
  # shellcheck disable=SC2086
  "$java_bin" -cp "$cp" histos.pack.Pack \
    --out "$jar" \
    --group "$group" \
    --artifact "$artifact" \
    --revision "$revision" \
    $pack_repos || fail "could not pack $group:$artifact:$revision"
  [ -f "$jar" ] || fail "packer wrote no jar"
}
ensure_toolchain() {
  selected=$1
  dir=$home/toolchains/$selected
  mkdir -p "$dir"
  manifest=$dir/manifest.json
  if [ ! -f "$manifest" ] || [ "$(json_string "$manifest" version)" != "$selected" ]; then
    place_manifest "$selected" "$manifest"
  fi
  [ "$(json_string "$manifest" version)" = "$selected" ] || fail "manifest version is not $selected"
  # A local asset manifest can move while the version id stays. Replace it before the jar is checked.
  if [ -n "${HISTOS_ASSETS:-}" ] && [ -f "${HISTOS_ASSETS}/manifest.json" ] && [ -f "$manifest" ]; then
    if ! same_pin "$manifest" "${HISTOS_ASSETS}/manifest.json"; then
      place_manifest "$selected" "$manifest"
      rm -f "$dir/histos.jar"
    fi
  fi
  # publish local staged the packed jar. Copy it. Do not fetch, pack, or check jarSha256.
  org=$(json_string "$manifest" ivyOrganisation)
  module=$(json_string "$manifest" ivyModule)
  rev=$(json_string "$manifest" ivyRevision)
  if [ -n "${HISTOS_ASSETS:-}" ] && [ -n "$org" ] && [ -n "$module" ] && [ -n "$rev" ]; then
    place_jar "$manifest" "$dir/histos.jar"
  else
    kind=$(manifest_kind "$manifest")
    case $kind in
      dist) install_dist_jar "$manifest" "$dir" ;;
      coordinate) install_coordinate "$manifest" "$dir" ;;
      *) fail "manifest has no jar and no coordinate" ;;
    esac
  fi
  # A runner skips the kit unless this install was asked to link. An explicit yes still places it.
  # A call with one argument leaves $2 unset, and set -u must not reject it.
  if [ "${2-}" = yes ] || ! ci_set; then place_kit "$manifest" "$dir/client-kit.zip"; fi
}
client_mode() {
  mode=$1
  # HISTOS_CLIENT does not override a runner. The --client flag arrives as yes and does.
  if [ "$mode" = ask ] && ! ci_set; then
    case ${HISTOS_CLIENT:-} in
      off|0|false|no) mode=no ;;
      on|1|true|yes) mode=yes ;;
    esac
  fi
  if [ "$mode" != yes ] && ci_set; then mode=no; fi
  printf '%s' "$mode"
}
# Reap the linker before joining the dot loop. kill -0 stays true until it is reaped.
link_client() {
  if [ -t 2 ]; then
    link_client_dots "$1"
  else
    link_client_plain "$1"
  fi
}
link_client_plain() {
  jar=$1
  printf '%s\n' "Linking the native client." >&2
  link_status=0
  "$java_bin" --enable-native-access=ALL-UNNAMED -jar "$jar" toolchain client || link_status=$?
  if [ "$link_status" -eq 0 ]; then
    printf '%s\n' "Linked the native client." >&2
  fi
  return "$link_status"
}
link_client_dots() {
  jar=$1
  link_log=$(mktemp)
  printf '%s' "Linking the native client" >&2
  "$java_bin" --enable-native-access=ALL-UNNAMED -jar "$jar" toolchain client >"$link_log" 2>&1 &
  link_pid=$!
  (
    while kill -0 "$link_pid" 2>/dev/null; do
      printf '.' >&2
      sleep 1
    done
  ) &
  link_dots=$!
  trap 'kill "$link_pid" "$link_dots" 2>/dev/null || true; wait "$link_pid" 2>/dev/null || true; wait "$link_dots" 2>/dev/null || true; rm -f "$link_log"; trap - INT TERM; exit 130' INT TERM
  link_status=0
  wait "$link_pid" || link_status=$?
  wait "$link_dots" 2>/dev/null || true
  trap - INT TERM
  printf '\n' >&2
  if [ "$link_status" -eq 0 ]; then
    printf '%s\n' "Linked the native client." >&2
  else
    cat "$link_log" >&2
  fi
  rm -f "$link_log"
  return "$link_status"
}
# Ask once per jar sha, from install and update only. A decline is remembered. An explicit client is a required link.
offer_client() {
  dir=$1
  mode=$(client_mode "$2")
  [ "$mode" = no ] && return 0
  [ -f "$dir/histos.jar" ] && [ -f "$dir/client-kit.zip" ] || return 0
  jar=$dir/histos.jar
  sha=$(hash_of "$jar")
  if [ -x "$dir/histos-client" ] && stamp_matches "$dir" "$jar"; then return 0; fi
  if [ -f "$dir/client.choice" ]; then
    remembered=$(tr -d '[:space:]' < "$dir/client.choice")
    [ "$remembered" = "$sha" ] && return 0
  fi
  version_name=$(json_string "$dir/manifest.json" version)
  [ -n "$version_name" ] || version_name=histos
  if [ "$mode" = ask ]; then
    if [ -t 0 ] && [ -t 2 ]; then
      printf '%s\n' \
        "histos $version_name is installed." \
        "A native client is optional. It starts compile, test, run, clean, and fmt without a JVM." \
        "Building it uses clang 21 on this machine and takes a few minutes, once for this version." \
        "Build it now? [Y/n]" >&2
      answer=
      read -r answer || answer=
      case $answer in
        n|N|no|NO) printf '%s\n' "$sha" > "$dir/client.choice"; return 0 ;;
        *) mode=yes ;;
      esac
    else
      echo "histos $version_name is installed. A native client is optional. Build one with: histos toolchain client" >&2
      return 0
    fi
  fi
  check_java
  if link_client "$jar"; then
    printf '%s\n' "$sha" > "$dir/client.stamp"
    rm -f "$dir/client.choice"
    return 0
  fi
  [ "$mode" = yes ] && return 1
  return 0
}
exec_jar() {
  jar=$1
  repo=$2
  shift 2
  if [ -z "${HISTOS_SHELL:-}" ]; then
    parent=$(ps -o comm= -p "$PPID" 2>/dev/null || true)
    parent=${parent#-}
    parent=${parent##*/}
    case "$parent" in
      zsh|bash)
        HISTOS_SHELL=$parent
        export HISTOS_SHELL
        ;;
      *)
        base=${SHELL:-}
        base=${base##*/}
        case "$base" in
          zsh|bash)
            HISTOS_SHELL=$base
            export HISTOS_SHELL
            ;;
        esac
        ;;
    esac
  fi
  check_java
  tool=$(dirname "$jar")
  use_jar=1
  if ! ci_set && [ -x "$tool/histos-client" ] && stamp_matches "$tool" "$jar"; then use_jar=0; fi
  if [ "$#" -ge 1 ]; then
    case $1 in
      server|bsp|mcp|toolchain) use_jar=1 ;;
    esac
  fi
  HISTOS_JAVA=$java_bin
  HISTOS_JAR=$jar
  HISTOS_VERSION="histos $version"
  export HISTOS_JAVA HISTOS_JAR HISTOS_VERSION
  if [ -n "$repo" ]; then HISTOS_ROOT=$repo; export HISTOS_ROOT; fi
  if [ "$use_jar" -eq 0 ]; then exec "$tool/histos-client" "$@"; fi
  jvm_extra=
  if [ -n "$repo" ] && [ -f "$repo/.jvmopts" ]; then
    while IFS= read -r opt || [ -n "$opt" ]; do
      opt=${opt%$(printf '\r')}
      case $opt in
        ''|\#*) continue ;;
        -jar|-m|--module) fail "jvm option selects the program: $opt" ;;
        @*) fail "jvm option selects the program: $opt" ;;
      esac
      jvm_extra="$jvm_extra $(printf '%s' "$opt" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/")"
    done < "$repo/.jvmopts"
  fi
  # shellcheck disable=SC2086
  eval "set -- $jvm_extra --enable-native-access=ALL-UNNAMED -jar $(printf '%s' "$jar" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/") $(for one in "$@"; do printf '%s' "$one" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/"; printf ' '; done)"
  exec "$java_bin" "$@"
}
