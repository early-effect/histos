#!/bin/sh
# Histos user install. One script: the installer and the command on PATH.
# It downloads a checksummed jar and, when the manifest has one, a native client.
# It does not install a JDK, Coursier, or clang.
set -eu
version=shim
fail() { echo "histos: $*" >&2; exit 1; }
hash_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}
valid_sha() { printf '%s\n' "$1" | awk 'length($0)==64 && $0 !~ /[^0-9a-fA-F]/ {ok=1} END {exit !ok}'; }
script_file() {
  file=$1
  [ -n "$file" ] && [ -f "$file" ] && grep -q 'Histos user install' "$file"
}
java_guide='A JDK 25 or newer is required. Histos does not install it.
macOS: brew install --cask temurin@25
Linux: https://adoptium.net/temurin/releases?version=25'
wsl_guide='Histos runs on macOS and Linux. On Windows, use WSL. A native Windows build may come later.'
home=${HISTOS_HOME:-$HOME/.histos}
# `update` sets these. The no-client message names the newest release.
newest_release=
stable=no
# ChannelRefresh.Default is Ttl(1 hour). every-call is ChannelRefresh.EveryCall.
channel_ttl=3600
channel_refresh=ttl
case ${HISTOS_CHANNEL_REFRESH:-ttl} in
  ttl) channel_refresh=ttl ;;
  every-call) channel_refresh=every-call ;;
  *) fail "HISTOS_CHANNEL_REFRESH is ttl or every-call" ;;
esac
dist=${HISTOS_DIST:-https://github.com/early-effect/histos/releases/download/dist}
case $dist in
  https://*) ;;
  http://127.0.0.1|http://127.0.0.1/*|http://127.0.0.1:*|http://localhost|http://localhost/*|http://localhost:*) ;;
  *) fail "dist base is not a supported url: $dist" ;;
esac
os=$(uname -s)
case $os in
  MINGW*|MSYS*|CYGWIN*|Windows*) fail "$wsl_guide" ;;
esac
arch=$(uname -m)
case "$os-$arch" in
  Darwin-arm64) platform=macos-aarch64 ;;
  Darwin-x86_64) platform=macos-x86_64 ;;
  Linux-x86_64|Linux-amd64) platform=linux-x86_64 ;;
  Linux-aarch64|Linux-arm64) platform=linux-aarch64 ;;
  *) platform= ;;
esac
fetch() {
  url=$1
  dest=$2
  mkdir -p "$(dirname "$dest")"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest" || fail "could not fetch $url"
  else
    fail "curl is not on PATH"
  fi
}
json_string() {
  awk -v key="$2" '
    {
      line = $0
      gsub(/^[ \t]+/, "", line)
      needle = "\"" key "\""
      if (index(line, needle) == 1) {
        n = split(line, parts, "\"")
        if (n >= 4) { print parts[4]; exit }
      }
    }
  ' "$1"
}
check_java() {
  java_bin=$(command -v java) || fail "java is not on PATH
$java_guide"
  java_text=$("$java_bin" -version 2>&1 || true)
  if ! java_found=$(printf '%s\n' "$java_text" | awk '
    /version "/ {
      if (match($0, /"[^"]+"/)) {
        print substr($0, RSTART + 1, RLENGTH - 2)
        found = 1
        exit
      }
    }
    END { if (!found) exit 1 }
  '); then
    fail "java version is unreadable
$java_guide"
  fi
  java_major=$(printf '%s\n' "$java_found" | awk -F. '{ if ($1 == "1" && NF >= 2) print $2 + 0; else print $1 + 0 }')
  [ "$java_major" -ge 25 ] || fail "java $java_found is older than 25
$java_guide"
}
verify_sha() {
  file=$1
  expected=$2
  valid_sha "$expected" || fail "invalid checksum for $file"
  [ -f "$file" ] || fail "missing $file"
  sha_matches "$file" "$expected" || fail "checksum mismatch for $file"
}
sha_matches() {
  [ "$(hash_of "$1")" = "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ]
}
mtime_of() {
  file=$1
  if stat -c %Y "$file" >/dev/null 2>&1; then
    stat -c %Y "$file"
  else
    stat -f %m "$file"
  fi
}
cached_channel() {
  file=$1
  [ "$channel_refresh" = ttl ] || return 1
  [ -f "$file" ] || return 1
  now=$(date +%s) || return 1
  then=$(mtime_of "$file") || return 1
  age=$((now - then))
  [ "$age" -ge 0 ] && [ "$age" -lt "$channel_ttl" ] || return 1
  resolved=$(tr -d '[:space:]' < "$file")
  [ -n "$resolved" ] || return 1
  printf '%s' "$resolved"
}
saved_channel() {
  file=$1
  [ -f "$file" ] || return 1
  resolved=$(tr -d '[:space:]' < "$file")
  [ -n "$resolved" ] || return 1
  printf '%s' "$resolved"
}
resolve_channel() {
  channel=$1
  case $channel in
    *-SNAPSHOT)
      cache=$home/channels/$channel
      if cached=$(cached_channel "$cache"); then
        printf '%s' "$cached"
        return 0
      fi
      tmp=$(mktemp)
      if fetch_ok "$dist/channel-$channel" "$tmp"; then
        resolved=$(tr -d '[:space:]' < "$tmp")
        rm -f "$tmp"
        if [ -n "$resolved" ]; then
          mkdir -p "$home/channels"
          printf '%s\n' "$resolved" > "$cache"
          printf '%s' "$resolved"
          return 0
        fi
      else
        rm -f "$tmp"
      fi
      if cached=$(saved_channel "$cache"); then
        printf '%s' "$cached"
        return 0
      fi
      fail "channel $channel did not resolve"
      ;;
    *) printf '%s' "$channel" ;;
  esac
}
fetch_ok() {
  curl -fsSL "$1" -o "$2" 2>/dev/null
}
read_default() {
  if [ -s "$home/default" ]; then
    tr -d '[:space:]' < "$home/default"
  else
    return 1
  fi
}
write_default() {
  printf '%s\n' "$1" > "$home/default"
}
# The newest `release` (X.Y.Z) or `snapshot` pointer (X.Y.Z-SNAPSHOT) among asset names on stdin, at or above the
# X.Y.Z in $2. An empty floor takes any. Fails when none qualifies.
newest() {
  awk -v kind="$1" -v floor_version="${2:-}" '
    function num(v, a, n) {
      n = split(v, a, ".")
      if (n != 3) return -1
      if (a[1] !~ /^[0-9]+$/ || a[2] !~ /^[0-9]+$/ || a[3] !~ /^[0-9]+$/) return -1
      return a[1] * 1000000 + a[2] * 1000 + a[3]
    }
    BEGIN { floor = num(floor_version); best = -1 }
    {
      if (kind == "snapshot" && $0 ~ /^channel-[0-9]+\.[0-9]+\.[0-9]+-SNAPSHOT$/) {
        ver = substr($0, 9)
        r = num(substr(ver, 1, length(ver) - 9))
      } else if (kind == "release" && $0 ~ /^[0-9]+\.[0-9]+\.[0-9]+-manifest\.json$/) {
        ver = substr($0, 1, length($0) - 14)
        r = num(ver)
      } else next
      if (r >= floor && r > best) { best = r; pick = ver }
    }
    END { if (pick == "") exit 1; print pick }
  '
}
# X.Y.Z of a pointer or a timestamp pin. A release is not a snapshot line.
snapshot_line() {
  case $1 in
    *-SNAPSHOT) printf '%s' "${1%-SNAPSHOT}" ;;
    *-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].[0-9][0-9][0-9][0-9][0-9][0-9]-[1-9]*) printf '%s' "${1%-*-*}" ;;
    *) return 1 ;;
  esac
}
asset_names() {
  awk '
    {
      line = $0
      while (match(line, /"name"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
        token = substr(line, RSTART, RLENGTH)
        split(token, q, "\"")
        print q[4]
        line = substr(line, RSTART + RLENGTH)
      }
    }
  ' "$1"
}
# Asset names on the dist base, one per line. A GitHub release lists its own. Any other base serves `assets`.
dist_assets() {
  listing=$(mktemp)
  listed=no
  case $dist in
    https://github.com/*/releases/download/*)
      owner_repo=${dist#https://github.com/}
      owner_repo=${owner_repo%%/releases/download/*}
      if fetch_ok "https://api.github.com/repos/$owner_repo/releases/tags/${dist##*/}" "$listing"; then
        asset_names "$listing"
        listed=yes
      fi
      ;;
  esac
  if [ "$listed" = no ] && fetch_ok "$dist/assets" "$listing"; then
    cat "$listing"
    listed=yes
  fi
  rm -f "$listing"
  [ "$listed" = yes ]
}
published_channel() {
  tmp=$(mktemp)
  if fetch_ok "$dist/channel" "$tmp"; then
    channel=$(tr -d '[:space:]' < "$tmp")
    if [ -n "$channel" ]; then
      rm -f "$tmp"
      printf '%s' "$channel"
      return 0
    fi
  fi
  if dist_assets > "$tmp" && { channel=$(newest snapshot < "$tmp") || channel=$(newest release < "$tmp"); }; then
    rm -f "$tmp"
    printf '%s' "$channel"
    return 0
  fi
  rm -f "$tmp"
  return 1
}
# Yes when --stable was passed or the terminal answers y. Without a terminal, prints how to switch.
take_stable() {
  release=$1
  pin=$2
  [ "$stable" = yes ] && return 0
  if [ -t 0 ] && [ -t 2 ] && { [ -z "${CI:-}" ] || [ "${CI:-}" = false ]; }; then
    printf 'histos %s is a stable release newer than %s. Switch to %s? [y/N] ' "$release" "$pin" "$release" >&2
    answer=
    read -r answer < /dev/tty || answer=
    case $answer in
      y|Y|yes|Yes|YES) return 0 ;;
      *) return 1 ;;
    esac
  fi
  echo "histos $release is a stable release. histos update --stable switches." >&2
  return 1
}
# Sets `next`, the pin `update` writes for $1. A release moves to the newest release. A snapshot moves to the newest
# line at or above its own and keeps its form unless `form` is freeze or follow. A release at or above that line is
# offered first.
next_pin() {
  pin=$1
  names=$(mktemp)
  dist_assets > "$names" || echo "histos: $dist does not list its assets. update keeps the line of $pin." >&2
  newest_release=$(newest release < "$names" || true)
  if ! line=$(snapshot_line "$pin"); then
    next=$(newest release "$pin" < "$names" || printf '%s' "$pin")
    rm -f "$names"
    return 0
  fi
  pointer=$(newest snapshot "$line" < "$names" || printf '%s-SNAPSHOT' "$line")
  offer=$(newest release "$line" < "$names" || true)
  rm -f "$names"
  if [ -n "$offer" ] && take_stable "$offer" "$pin"; then
    next=$offer
    return 0
  fi
  if [ "$form" = keep ]; then
    case $pin in
      *-SNAPSHOT) form=follow ;;
      *) form=freeze ;;
    esac
  fi
  case $form in
    follow) next=$pointer ;;
    freeze) next=$(resolve_channel "$pointer") ;;
  esac
}
no_default() {
  fail "no default toolchain. Run 'histos toolchain install <version>'"
}
find_repo() {
  dir=$PWD
  while :; do
    if [ -f "$dir/build.properties" ] || [ -f "$dir/.histos/toolchain" ]; then
      printf '%s' "$dir"
      return 0
    fi
    parent=$(dirname "$dir")
    [ "$parent" = "$dir" ] && return 1
    dir=$parent
  done
}
# The id, or nothing when the file is absent. A bad id is rejected by the caller so `exit` is not trapped in `$()`.
read_toolchain() {
  file=$1/.histos/toolchain
  [ -f "$file" ] || return 1
  tr -d '[:space:]' < "$file"
}
read_pin() {
  props=$1/build.properties
  [ -f "$props" ] || return 1
  awk '
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    {
      eq = index($0, "=")
      if (eq <= 1) exit 1
      key = substr($0, 1, eq - 1)
      value = substr($0, eq + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      if (key == "histos.version" && value != "") { print value; found = 1; exit }
    }
    END { if (!found) exit 1 }
  ' "$props"
}
write_pin() {
  props=$2/build.properties
  if [ -f "$props" ]; then
    awk -v version="$1" '
      BEGIN { done = 0 }
      /^[ \t]*histos\.version[ \t]*=/ { print "histos.version=" version; done = 1; next }
      { print }
      END { if (!done) print "histos.version=" version }
    ' "$props" > "$props.next"
    mv "$props.next" "$props"
  else
    printf 'histos.version=%s\n' "$1" > "$props"
  fi
}
# The client sha the manifest names for this platform. Fails when it names none.
platform_client() {
  [ -n "$platform" ] || return 1
  named=$(json_string "$1" "$platform")
  [ -n "$named" ] || return 1
  printf '%s' "$named"
}
# A toolchain is ready when its jar and manifest are on disk and the client the manifest names for this platform is
# executable. A ready toolchain runs without the network. A version's manifest never changes, so the copy is kept.
toolchain_ready() {
  dir=$home/toolchains/$1
  [ -f "$dir/histos.jar" ] && [ -f "$dir/manifest.json" ] || return 1
  if platform_client "$dir/manifest.json" >/dev/null; then [ -x "$dir/histos-client" ]; fi
}
# Fetch what the toolchain directory is missing, and check the jar and the client against the manifest.
ensure_toolchain() {
  selected=$1
  dir=$home/toolchains/$selected
  mkdir -p "$dir"
  manifest=$dir/manifest.json
  if [ ! -f "$manifest" ] || [ "$(json_string "$manifest" version)" != "$selected" ]; then
    fetch "$dist/$selected-manifest.json" "$manifest"
  fi
  [ "$(json_string "$manifest" version)" = "$selected" ] || fail "manifest version is not $selected"
  jar_name=$(json_string "$manifest" jar)
  jar_sha=$(json_string "$manifest" jarSha256)
  [ -n "$jar_name" ] && [ -n "$jar_sha" ] || fail "manifest has no jar"
  jar=$dir/histos.jar
  if [ -f "$jar" ] && ! sha_matches "$jar" "$jar_sha"; then rm -f "$jar"; fi
  [ -f "$jar" ] || fetch "$dist/$jar_name" "$jar"
  verify_sha "$jar" "$jar_sha"
  client=$dir/histos-client
  origin=$dir/client.origin
  if client_sha=$(platform_client "$manifest"); then
    if [ ! -x "$client" ] || ! sha_matches "$client" "$client_sha"; then
      fetched=$dir/histos-client.download
      fetch "$dist/$selected-client-$platform" "$fetched"
      verify_sha "$fetched" "$client_sha"
      mv "$fetched" "$client"
      chmod +x "$client"
      printf 'prebuilt\n' > "$origin"
    fi
  else
    rm -f "$client" "$origin"
    echo "histos $selected has no prebuilt client for ${platform:-this platform}$(release_client). java -jar will run." >&2
  fi
}
# "; <release> has one" when the newest release `update` saw names a client for this platform.
release_client() {
  [ -n "$newest_release" ] && [ -n "$platform" ] || return 0
  listing=$(mktemp)
  if fetch_ok "$dist/$newest_release-manifest.json" "$listing" && [ -n "$(json_string "$listing" "$platform")" ]; then
    printf '; %s has one' "$newest_release"
  fi
  rm -f "$listing"
}
exec_jar() {
  jar=$1
  repo=$2
  shift 2
  check_java
  tool=$(dirname "$jar")
  client=
  if [ -x "$tool/histos-client" ]; then client=$tool/histos-client; fi
  use_jar=1
  if [ "$#" -ge 1 ]; then
    case $1 in
      server|bsp|mcp) use_jar=1 ;;
      *) [ -n "$client" ] && use_jar=0 ;;
    esac
  fi
  HISTOS_JAVA=$java_bin
  HISTOS_JAR=$jar
  HISTOS_VERSION="histos $version"
  export HISTOS_JAVA HISTOS_JAR HISTOS_VERSION
  if [ -n "$repo" ]; then HISTOS_ROOT=$repo; export HISTOS_ROOT; fi
  if [ "$use_jar" -eq 0 ]; then exec "$client" "$@"; fi
  jvm_extra=
  if [ -n "$repo" ] && [ -f "$repo/.jvmopts" ]; then
    while IFS= read -r opt || [ -n "$opt" ]; do
      opt=${opt%$(printf '\r')}
      case $opt in
        ''|\#*) continue ;;
        -jar|-m|--module) fail "jvm option selects the program: $opt" ;;
        @*) fail "jvm option selects the program: $opt" ;;
      esac
      jvm_extra="$jvm_extra $(printf '%s' "$opt" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/")"
    done < "$repo/.jvmopts"
  fi
  # shellcheck disable=SC2086
  eval "set -- $jvm_extra --enable-native-access=ALL-UNNAMED -jar $(printf '%s' "$jar" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/") $(for one in "$@"; do printf '%s' "$one" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/"; printf ' '; done)"
  exec "$java_bin" "$@"
}
installed=$home/bin/histos
self=$0
case $self in
  */*) ;;
  *) self=$(command -v "$self" || printf '%s' "$self") ;;
esac
if [ -f "$self" ]; then
  self_dir=$(CDPATH= cd -- "$(dirname "$self")" && pwd)
  self_path=$self_dir/$(basename "$self")
else
  self_path=
fi
# A PATH symlink to the installed shim is the same file. cp then fails with "are the same file".
if [ "$self_path" != "$installed" ] && { [ -z "$self_path" ] || [ ! -e "$installed" ] || [ ! "$self_path" -ef "$installed" ]; }; then
  mkdir -p "$home/bin"
  if script_file "$self_path"; then
    cp "$self_path" "$installed"
    chmod +x "$installed"
  else
    tmp=$(mktemp)
    fetch "$dist/shim.sha256" "$tmp"
    expected=$(tr -d '[:space:]' < "$tmp")
    rm -f "$tmp"
    fetch "$dist/shim" "$installed"
    verify_sha "$installed" "$expected"
    chmod +x "$installed"
  fi
  if [ "$#" -eq 0 ]; then
    if [ ! -s "$home/default" ]; then
      channel=$(published_channel) || no_default
      write_default "$channel"
    fi
    echo "export PATH=\"\$HOME/.histos/bin:\$PATH\""
    exit 0
  fi
  exec "$installed" "$@"
fi
cmd=${1:-}
case $cmd in
  self)
    shift
    sub=${1:-}
    [ "$sub" = update ] || fail "unknown command 'self ${sub:-}'
did you mean self update?
histos help
histos help self"
    tmp=$(mktemp)
    fetch "$dist/shim.sha256" "$tmp"
    expected=$(tr -d '[:space:]' < "$tmp")
    rm -f "$tmp"
    current=$(hash_of "$installed")
    want=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
    if [ "$current" = "$want" ]; then exit 0; fi
    next=$home/bin/histos.next
    fetch "$dist/shim" "$next"
    verify_sha "$next" "$expected"
    chmod +x "$next"
    mv "$next" "$installed"
    exit 0
    ;;
  toolchain)
    shift
    sub=${1:-}
    case $sub in
      list)
        if [ -d "$home/toolchains" ]; then
          find "$home/toolchains" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
        fi
        exit 0
        ;;
      install)
        shift
        [ "$#" -eq 1 ] && [ -n "$1" ] || fail "usage: histos toolchain install <version>"
        selected=$1
        channel_refresh=every-call
        selected=$(resolve_channel "$selected")
        ensure_toolchain "$selected"
        if [ ! -s "$home/default" ]; then write_default "$selected"; fi
        exit 0
        ;;
      *) fail "unknown command 'toolchain ${sub:-}'
histos toolchain install <version>
histos toolchain list
histos help toolchain" ;;
    esac
    ;;
  update)
    shift
    make_default=no
    form=keep
    for flag in "$@"; do
      case $flag in
        --make-default) make_default=yes ;;
        --stable) stable=yes ;;
        --freeze|--follow)
          [ "$form" = keep ] || [ "$form" = "${flag#--}" ] || fail "--freeze and --follow are opposites. Pass one."
          form=${flag#--}
          ;;
        *) fail "unknown update flag: $flag" ;;
      esac
    done
    channel_refresh=every-call
    repo=$(find_repo || true)
    if [ -n "$repo" ] && pin=$(read_pin "$repo"); then
      next_pin "$pin"
      write_pin "$next" "$repo"
      if [ "$make_default" = yes ]; then write_default "$next"; fi
    else
      current=$(read_default || true)
      if [ -z "$current" ]; then
        current=$(published_channel) || no_default
      fi
      next_pin "$current"
      write_default "$next"
      selected=$(resolve_channel "$next")
      ensure_toolchain "$selected"
      exit 0
    fi
    selected=$(resolve_channel "$next")
    ensure_toolchain "$selected"
    # version enters the jar. That rewrites .bsp/histos.json from the pin and reboots a server on another driver.
    version=$selected
    jar=$home/toolchains/$selected/histos.jar
    if id=$(read_toolchain "$repo"); then
      case $id in
        ""|.*|*/*|*\\*) fail "local toolchain id is not one path segment" ;;
      esac
      jar=$home/toolchains/$id/histos.jar
      [ -f "$jar" ] || fail "local toolchain $id is not installed"
      version=$id
    fi
    exec_jar "$jar" "$repo" version
    ;;
esac
repo=$(find_repo || true)
if [ -n "$repo" ] && id=$(read_toolchain "$repo"); then
  case $id in
    ""|.*|*/*|*\\*) fail "local toolchain id is not one path segment" ;;
  esac
  jar=$home/toolchains/$id/histos.jar
  [ -f "$jar" ] || fail "local toolchain $id is not installed"
  version=$id
  exec_jar "$jar" "$repo" "$@"
fi
if [ -n "$repo" ] && pin=$(read_pin "$repo"); then
  selected=$(resolve_channel "$pin")
else
  current=$(read_default || true)
  if [ -z "$current" ]; then
    current=$(published_channel) || no_default
    write_default "$current"
  fi
  selected=$(resolve_channel "$current")
fi
version=$selected
toolchain_ready "$selected" || ensure_toolchain "$selected"
exec_jar "$home/toolchains/$selected/histos.jar" "$repo" "$@"
