    else
      current=$(read_default || true)
      if [ -z "$current" ]; then
        current=$(published_channel) || no_default
      fi
      next_pin "$current"
      write_default "$next"
      selected=$(resolve_channel "$next")
      ensure_toolchain "$selected"
      offer_client "$home/toolchains/$selected" "$client_flag"
      exit 0
    fi
    selected=$(resolve_channel "$next")
    local_id=
    if id=$(read_toolchain "$repo"); then local_id=$id; fi
    version=$(driver_id update "$selected" "$local_id")
    ensure_toolchain "$version"
    jar=$home/toolchains/$version/histos.jar
    offer_client "$(dirname "$jar")" "$client_flag"
    # The previous record is gone before version runs, so the new driver does not talk to that server.
    retire_server "$repo"
    exec_jar "$jar" "$repo" version
