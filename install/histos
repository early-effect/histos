#!/bin/sh
# Histos user install. One script: the installer and the command on PATH.
# It downloads a checksummed jar and, when the manifest names one, a link kit.
# It does not install a JDK, Coursier, or clang. A native client is optional and built on this machine.
set -eu
version=shim
fail() { echo "histos: $*" >&2; exit 1; }
# selected is the pin this command resolved. local_id is the id in .histos/toolchain, or empty.
# update runs selected. Any other command runs local_id when it is set.
driver_id() {
  command_name=$1
  selected=$2
  local_id=$3
  case $command_name in
    update) printf '%s' "$selected" ;;
    *)
      if [ -n "$local_id" ]; then printf '%s' "$local_id"
      else printf '%s' "$selected"
      fi
      ;;
  esac
}
# Dry run of driver_id. No JDK, no fetch, no install.
if [ "${1:-}" = --driver-id ]; then
  [ "$#" -eq 4 ] || fail "usage: histos --driver-id <command> <selected> <local>"
  driver_id "$2" "$3" "$4"
  printf '\n'
  exit 0
fi
hash_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}
valid_sha() { printf '%s\n' "$1" | awk 'length($0)==64 && $0 !~ /[^0-9a-fA-F]/ {ok=1} END {exit !ok}'; }
script_file() {
  file=$1
  [ -n "$file" ] && [ -f "$file" ] && grep -q 'Histos user install' "$file"
}
java_guide='A JDK 25 or newer is required. Histos does not install it.
macOS: brew install --cask temurin@25
Linux: https://adoptium.net/temurin/releases?version=25'
wsl_guide='Histos runs on macOS and Linux. On Windows, use WSL. A native Windows build may come later.'
home=${HISTOS_HOME:-$HOME/.histos}
stable=no
# ChannelRefresh.Default is Ttl(1 hour). every-call is ChannelRefresh.EveryCall.
channel_ttl=3600
channel_refresh=ttl
case ${HISTOS_CHANNEL_REFRESH:-ttl} in
  ttl) channel_refresh=ttl ;;
  every-call) channel_refresh=every-call ;;
  *) fail "HISTOS_CHANNEL_REFRESH is ttl or every-call" ;;
esac
dist=${HISTOS_DIST:-https://github.com/early-effect/histos/releases/download/dist}
case $dist in
  https://*) ;;
  http://127.0.0.1|http://127.0.0.1/*|http://127.0.0.1:*|http://localhost|http://localhost/*|http://localhost:*) ;;
  *) fail "dist base is not a supported url: $dist" ;;
esac
os=$(uname -s)
case $os in
  MINGW*|MSYS*|CYGWIN*|Windows*) fail "$wsl_guide" ;;
esac
fetch() {
  url=$1
  dest=$2
  mkdir -p "$(dirname "$dest")"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest" || fail "could not fetch $url"
  else
    fail "curl is not on PATH"
  fi
}
json_string() {
  awk -v key="$2" '
    {
      line = $0
      gsub(/^[ \t]+/, "", line)
      needle = "\"" key "\""
      if (index(line, needle) == 1) {
        n = split(line, parts, "\"")
        if (n >= 4) { print parts[4]; exit }
      }
    }
  ' "$1"
}
# A string field anywhere in a JSON object. A missing key prints nothing. Manifest lines stay on json_string.
json_field() {
  awk -v key="$2" '
    BEGIN { needle = "\"" key "\"" }
    {
      i = index($0, needle)
      if (i == 0) next
      rest = substr($0, i + length(needle))
      sub(/^[[:space:]]*:[[:space:]]*/, "", rest)
      if (substr(rest, 1, 1) != "\"") next
      rest = substr(rest, 2)
      out = ""
      esc = 0
      while (length(rest) > 0) {
        ch = substr(rest, 1, 1)
        rest = substr(rest, 2)
        if (esc) { out = out ch; esc = 0; continue }
        if (ch == "\\") { esc = 1; continue }
        if (ch == "\"") { print out; exit }
        out = out ch
      }
    }
  ' "$1"
}
# The previous server's record is not part of update. Remove it, and a socket it names under this checkout or this home.
retire_server() {
  repo=$1
  record=$repo/.histos/server.json
  [ -f "$record" ] || return 0
  socket=$(json_field "$record" socket || true)
  case $socket in
    "$repo/.histos/"*|"$home/run/"*) rm -f -- "$socket" ;;
  esac
  rm -f -- "$record" "$repo/.histos/server.json.tmp" "$repo/.histos/server.sock"
}
check_java() {
  java_bin=$(command -v java) || fail "java is not on PATH
$java_guide"
  java_text=$("$java_bin" -version 2>&1 || true)
  if ! java_found=$(printf '%s\n' "$java_text" | awk '
    /version "/ {
      if (match($0, /"[^"]+"/)) {
        print substr($0, RSTART + 1, RLENGTH - 2)
        found = 1
        exit
      }
    }
    END { if (!found) exit 1 }
  '); then
    fail "java version is unreadable
$java_guide"
  fi
  java_major=$(printf '%s\n' "$java_found" | awk -F. '{ if ($1 == "1" && NF >= 2) print $2 + 0; else print $1 + 0 }')
  [ "$java_major" -ge 25 ] || fail "java $java_found is older than 25
$java_guide"
}
verify_sha() {
  file=$1
  expected=$2
  valid_sha "$expected" || fail "invalid checksum for $file"
  [ -f "$file" ] || fail "missing $file"
  sha_matches "$file" "$expected" || fail "checksum mismatch for $file"
}
sha_matches() {
  [ "$(hash_of "$1")" = "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" ]
}
mtime_of() {
  file=$1
  if stat -c %Y "$file" >/dev/null 2>&1; then
    stat -c %Y "$file"
  else
    stat -f %m "$file"
  fi
}
cached_channel() {
  file=$1
  [ "$channel_refresh" = ttl ] || return 1
  [ -f "$file" ] || return 1
  now=$(date +%s) || return 1
  then=$(mtime_of "$file") || return 1
  age=$((now - then))
  [ "$age" -ge 0 ] && [ "$age" -lt "$channel_ttl" ] || return 1
  resolved=$(tr -d '[:space:]' < "$file")
  [ -n "$resolved" ] || return 1
  printf '%s' "$resolved"
}
saved_channel() {
  file=$1
  [ -f "$file" ] || return 1
  resolved=$(tr -d '[:space:]' < "$file")
  [ -n "$resolved" ] || return 1
  printf '%s' "$resolved"
}
resolve_channel() {
  channel=$1
  # Local assets already name one toolchain. There is no channel file to fetch.
  if [ -n "${HISTOS_ASSETS:-}" ]; then
    printf '%s' "$channel"
    return 0
  fi
  case $channel in
    *-SNAPSHOT)
      cache=$home/channels/$channel
      if cached=$(cached_channel "$cache"); then
        printf '%s' "$cached"
        return 0
      fi
      tmp=$(mktemp)
      if fetch_ok "$dist/channel-$channel" "$tmp"; then
        resolved=$(tr -d '[:space:]' < "$tmp")
        rm -f "$tmp"
        if [ -n "$resolved" ]; then
          mkdir -p "$home/channels"
          printf '%s\n' "$resolved" > "$cache"
          printf '%s' "$resolved"
          return 0
        fi
      else
        rm -f "$tmp"
      fi
      if cached=$(saved_channel "$cache"); then
        printf '%s' "$cached"
        return 0
      fi
      fail "channel $channel did not resolve"
      ;;
    *) printf '%s' "$channel" ;;
  esac
}
fetch_ok() {
  curl -fsSL "$1" -o "$2" 2>/dev/null
}
read_default() {
  if [ -s "$home/default" ]; then
    tr -d '[:space:]' < "$home/default"
  else
    return 1
  fi
}
write_default() {
  printf '%s\n' "$1" > "$home/default"
}
# The newest `release` (X.Y.Z) or `snapshot` pointer (X.Y.Z-SNAPSHOT) among asset names on stdin, at or above the
# X.Y.Z in $2. An empty floor takes any. Fails when none qualifies.
newest() {
  awk -v kind="$1" -v floor_version="${2:-}" '
    function num(v, a, n) {
      n = split(v, a, ".")
      if (n != 3) return -1
      if (a[1] !~ /^[0-9]+$/ || a[2] !~ /^[0-9]+$/ || a[3] !~ /^[0-9]+$/) return -1
      return a[1] * 1000000 + a[2] * 1000 + a[3]
    }
    BEGIN { floor = num(floor_version); best = -1 }
    {
      if (kind == "snapshot" && $0 ~ /^channel-[0-9]+\.[0-9]+\.[0-9]+-SNAPSHOT$/) {
        ver = substr($0, 9)
        r = num(substr(ver, 1, length(ver) - 9))
      } else if (kind == "release" && $0 ~ /^[0-9]+\.[0-9]+\.[0-9]+-manifest\.json$/) {
        ver = substr($0, 1, length($0) - 14)
        r = num(ver)
      } else next
      if (r >= floor && r > best) { best = r; pick = ver }
    }
    END { if (pick == "") exit 1; print pick }
  '
}
# X.Y.Z of a pointer or a timestamp pin. A release is not a snapshot line.
snapshot_line() {
  case $1 in
    *-SNAPSHOT) printf '%s' "${1%-SNAPSHOT}" ;;
    *-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].[0-9][0-9][0-9][0-9][0-9][0-9]-[1-9]*) printf '%s' "${1%-*-*}" ;;
    *) return 1 ;;
  esac
}
asset_names() {
  awk '
    {
      line = $0
      while (match(line, /"name"[[:space:]]*:[[:space:]]*"[^"]+"/)) {
        token = substr(line, RSTART, RLENGTH)
        split(token, q, "\"")
        print q[4]
        line = substr(line, RSTART + RLENGTH)
      }
    }
  ' "$1"
}
# Asset names on the dist base, one per line. A GitHub release lists its own. Any other base serves `assets`.
dist_assets() {
  listing=$(mktemp)
  listed=no
  case $dist in
    https://github.com/*/releases/download/*)
      owner_repo=${dist#https://github.com/}
      owner_repo=${owner_repo%%/releases/download/*}
      if fetch_ok "https://api.github.com/repos/$owner_repo/releases/tags/${dist##*/}" "$listing"; then
        asset_names "$listing"
        listed=yes
      fi
      ;;
  esac
  if [ "$listed" = no ] && fetch_ok "$dist/assets" "$listing"; then
    cat "$listing"
    listed=yes
  fi
  rm -f "$listing"
  [ "$listed" = yes ]
}
# The default is the latest stable release. A snapshot pointer is used only when dist has no release.
# An explicit channel asset wins over both.
published_channel() {
  tmp=$(mktemp)
  if fetch_ok "$dist/channel" "$tmp"; then
    channel=$(tr -d '[:space:]' < "$tmp")
    if [ -n "$channel" ]; then
      rm -f "$tmp"
      printf '%s' "$channel"
      return 0
    fi
  fi
  if dist_assets > "$tmp" && { channel=$(newest release < "$tmp") || channel=$(newest snapshot < "$tmp"); }; then
    rm -f "$tmp"
    printf '%s' "$channel"
    return 0
  fi
  rm -f "$tmp"
  return 1
}
# Yes when --stable was passed or the terminal answers y. Without a terminal, prints how to switch.
take_stable() {
  release=$1
  pin=$2
  [ "$stable" = yes ] && return 0
  if [ -t 0 ] && [ -t 2 ] && { [ -z "${CI:-}" ] || [ "${CI:-}" = false ]; }; then
    printf 'histos %s is a stable release newer than %s. Switch to %s? [y/N] ' "$release" "$pin" "$release" >&2
    answer=
    read -r answer < /dev/tty || answer=
    case $answer in
      y|Y|yes|Yes|YES) return 0 ;;
      *) return 1 ;;
    esac
  fi
  echo "histos $release is a stable release. histos update --stable switches." >&2
  return 1
}
# Sets `next`, the pin `update` writes for $1. A release moves to the newest release. A snapshot moves to the newest
# line at or above its own and keeps its form unless `form` is freeze or follow. A release at or above that line is
# offered first.
next_pin() {
  pin=$1
  names=$(mktemp)
  dist_assets > "$names" || echo "histos: $dist does not list its assets. update keeps the line of $pin." >&2
  if ! line=$(snapshot_line "$pin"); then
    next=$(newest release "$pin" < "$names" || printf '%s' "$pin")
    rm -f "$names"
    return 0
  fi
  pointer=$(newest snapshot "$line" < "$names" || printf '%s-SNAPSHOT' "$line")
  offer=$(newest release "$line" < "$names" || true)
  rm -f "$names"
  if [ -n "$offer" ] && take_stable "$offer" "$pin"; then
    next=$offer
    return 0
  fi
  if [ "$form" = keep ]; then
    case $pin in
      *-SNAPSHOT) form=follow ;;
      *) form=freeze ;;
    esac
  fi
  case $form in
    follow) next=$pointer ;;
    freeze) next=$(resolve_channel "$pointer") ;;
  esac
}
no_default() {
  fail "no default toolchain. Run 'histos toolchain install <version>'"
}
find_repo() {
  dir=$PWD
  while :; do
    if [ -f "$dir/build.properties" ] || [ -f "$dir/.histos/toolchain" ]; then
      printf '%s' "$dir"
      return 0
    fi
    parent=$(dirname "$dir")
    [ "$parent" = "$dir" ] && return 1
    dir=$parent
  done
}
# The id, or nothing when the file is absent. A bad id is rejected by the caller so `exit` is not trapped in `$()`.
read_toolchain() {
  file=$1/.histos/toolchain
  [ -f "$file" ] || return 1
  tr -d '[:space:]' < "$file"
}
read_pin() {
  props=$1/build.properties
  [ -f "$props" ] || return 1
  awk '
    /^[ \t]*#/ || /^[ \t]*$/ { next }
    {
      eq = index($0, "=")
      if (eq <= 1) exit 1
      key = substr($0, 1, eq - 1)
      value = substr($0, eq + 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      gsub(/^[ \t]+|[ \t]+$/, "", value)
      if (key == "histos.version" && value != "") { print value; found = 1; exit }
    }
    END { if (!found) exit 1 }
  ' "$props"
}
write_pin() {
  props=$2/build.properties
  if [ -f "$props" ]; then
    awk -v version="$1" '
      BEGIN { done = 0 }
      /^[ \t]*histos\.version[ \t]*=/ { print "histos.version=" version; done = 1; next }
      { print }
      END { if (!done) print "histos.version=" version }
    ' "$props" > "$props.next"
    mv "$props.next" "$props"
  else
    printf 'histos.version=%s\n' "$1" > "$props"
  fi
}
ci_set() {
  [ -n "${CI:-}" ] && [ "${CI}" != "false" ]
}
stamp_matches() {
  tool=$1
  jar=$2
  [ -f "$tool/client.stamp" ] || return 1
  want=$(tr -d '[:space:]' < "$tool/client.stamp")
  got=$(hash_of "$jar")
  [ "$want" = "$got" ]
}
copy_asset() {
  name=$1
  dest=$2
  src=${HISTOS_ASSETS}/$name
  [ -f "$src" ] || fail "no $name under HISTOS_ASSETS. publish local writes dist/install"
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
}
place_manifest() {
  selected=$1
  dest=$2
  if [ -n "${HISTOS_ASSETS:-}" ]; then
    copy_asset manifest.json "$dest"
  else
    fetch "$dist/$selected-manifest.json" "$dest"
  fi
}
place_jar() {
  manifest=$1
  dest=$2
  if [ -n "${HISTOS_ASSETS:-}" ]; then
    org=$(json_string "$manifest" ivyOrganisation)
    module=$(json_string "$manifest" ivyModule)
    rev=$(json_string "$manifest" ivyRevision)
    [ -n "$org" ] && [ -n "$module" ] && [ -n "$rev" ] || fail "local manifest has no ivy coordinate. publish local first"
    ivy=${HISTOS_IVY:-$HOME/.ivy2/local}
    src=$ivy/$org/$module/$rev/jars/$module.jar
    [ -f "$src" ] || fail "no jar at $src. publish local first"
    cp "$src" "$dest"
  else
    name=$(json_string "$manifest" jar)
    [ -n "$name" ] || fail "manifest has no jar"
    fetch "$dist/$name" "$dest"
  fi
}
# A missing kit does not fail install. The jar still runs.
place_kit() {
  manifest=$1
  dest=$2
  name=$(json_string "$manifest" clientKit)
  [ -n "$name" ] || return 0
  sha=$(json_string "$manifest" clientKitSha256)
  [ -n "$sha" ] || return 0
  if [ -f "$dest" ] && ! sha_matches "$dest" "$sha"; then rm -f "$dest"; fi
  if [ ! -f "$dest" ]; then
    if [ -n "${HISTOS_ASSETS:-}" ]; then
      src=${HISTOS_ASSETS}/$name
      if [ ! -f "$src" ]; then
        echo "histos: no client kit under HISTOS_ASSETS. histos toolchain client builds one after publish local." >&2
        return 0
      fi
      cp "$src" "$dest"
    elif ! fetch_ok "$dist/$name" "$dest"; then
      echo "histos: could not fetch the client kit. java -jar will run." >&2
      rm -f "$dest"
      return 0
    fi
  fi
  if ! sha_matches "$dest" "$sha"; then
    echo "histos: client kit checksum did not match. java -jar will run." >&2
    rm -f "$dest"
  fi
}
# A toolchain is ready when its jar and manifest are on disk. The client is optional.
toolchain_ready() {
  dir=$home/toolchains/$1
  [ -f "$dir/histos.jar" ] && [ -f "$dir/manifest.json" ]
}
ensure_toolchain() {
  selected=$1
  dir=$home/toolchains/$selected
  mkdir -p "$dir"
  manifest=$dir/manifest.json
  if [ ! -f "$manifest" ] || [ "$(json_string "$manifest" version)" != "$selected" ]; then
    place_manifest "$selected" "$manifest"
  fi
  [ "$(json_string "$manifest" version)" = "$selected" ] || fail "manifest version is not $selected"
  # A local asset manifest can move while the version id stays. Replace it before the jar is checked.
  if [ -n "${HISTOS_ASSETS:-}" ] && [ -f "${HISTOS_ASSETS}/manifest.json" ] && [ -f "$manifest" ]; then
    asset_sha=$(json_string "${HISTOS_ASSETS}/manifest.json" jarSha256)
    have_sha=$(json_string "$manifest" jarSha256)
    if [ -n "$asset_sha" ] && [ "$asset_sha" != "$have_sha" ]; then
      place_manifest "$selected" "$manifest"
    fi
  fi
  jar_sha=$(json_string "$manifest" jarSha256)
  [ -n "$(json_string "$manifest" jar)" ] && [ -n "$jar_sha" ] || fail "manifest has no jar"
  jar=$dir/histos.jar
  if [ -f "$jar" ] && ! sha_matches "$jar" "$jar_sha"; then rm -f "$jar"; fi
  [ -f "$jar" ] || place_jar "$manifest" "$jar"
  verify_sha "$jar" "$jar_sha"
  if ! ci_set; then place_kit "$manifest" "$dir/client-kit.zip"; fi
}
client_mode() {
  mode=$1
  if [ "$mode" = ask ]; then
    case ${HISTOS_CLIENT:-} in
      off|0|false|no) mode=no ;;
      on|1|true|yes) mode=yes ;;
    esac
  fi
  if ci_set; then mode=no; fi
  printf '%s' "$mode"
}
# Ask once per jar sha, from install and update only. A decline is remembered. CI never links.
offer_client() {
  dir=$1
  mode=$(client_mode "$2")
  [ "$mode" = no ] && return 0
  [ -f "$dir/histos.jar" ] && [ -f "$dir/client-kit.zip" ] || return 0
  jar=$dir/histos.jar
  sha=$(hash_of "$jar")
  if [ -x "$dir/histos-client" ] && stamp_matches "$dir" "$jar"; then return 0; fi
  if [ -f "$dir/client.choice" ]; then
    remembered=$(tr -d '[:space:]' < "$dir/client.choice")
    [ "$remembered" = "$sha" ] && return 0
  fi
  version_name=$(json_string "$dir/manifest.json" version)
  [ -n "$version_name" ] || version_name=histos
  if [ "$mode" = ask ]; then
    if [ -t 0 ] && [ -t 2 ]; then
      printf '%s\n' \
        "histos $version_name is installed." \
        "A native client is optional. It starts compile, test, run, clean, and fmt without a JVM." \
        "Building it uses clang 21 on this machine and takes a few minutes, once for this version." \
        "Build it now? [Y/n]" >&2
      answer=
      read -r answer || answer=
      case $answer in
        n|N|no|NO) printf '%s\n' "$sha" > "$dir/client.choice"; return 0 ;;
        *) mode=yes ;;
      esac
    else
      echo "histos $version_name is installed. A native client is optional. Build one with: histos toolchain client" >&2
      return 0
    fi
  fi
  check_java
  if "$java_bin" --enable-native-access=ALL-UNNAMED -jar "$jar" toolchain client; then
    printf '%s\n' "$sha" > "$dir/client.stamp"
    rm -f "$dir/client.choice"
  fi
  return 0
}
exec_jar() {
  jar=$1
  repo=$2
  shift 2
  check_java
  tool=$(dirname "$jar")
  use_jar=1
  if ! ci_set && [ -x "$tool/histos-client" ] && stamp_matches "$tool" "$jar"; then use_jar=0; fi
  if [ "$#" -ge 1 ]; then
    case $1 in
      server|bsp|mcp|toolchain) use_jar=1 ;;
    esac
  fi
  HISTOS_JAVA=$java_bin
  HISTOS_JAR=$jar
  HISTOS_VERSION="histos $version"
  export HISTOS_JAVA HISTOS_JAR HISTOS_VERSION
  if [ -n "$repo" ]; then HISTOS_ROOT=$repo; export HISTOS_ROOT; fi
  if [ "$use_jar" -eq 0 ]; then exec "$tool/histos-client" "$@"; fi
  jvm_extra=
  if [ -n "$repo" ] && [ -f "$repo/.jvmopts" ]; then
    while IFS= read -r opt || [ -n "$opt" ]; do
      opt=${opt%$(printf '\r')}
      case $opt in
        ''|\#*) continue ;;
        -jar|-m|--module) fail "jvm option selects the program: $opt" ;;
        @*) fail "jvm option selects the program: $opt" ;;
      esac
      jvm_extra="$jvm_extra $(printf '%s' "$opt" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/")"
    done < "$repo/.jvmopts"
  fi
  # shellcheck disable=SC2086
  eval "set -- $jvm_extra --enable-native-access=ALL-UNNAMED -jar $(printf '%s' "$jar" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/") $(for one in "$@"; do printf '%s' "$one" | sed "s/'/'\\\\''/g; s/^/'/; s/\$/'/"; printf ' '; done)"
  exec "$java_bin" "$@"
}
installed=$home/bin/histos
self=$0
case $self in
  */*) ;;
  *) self=$(command -v "$self" || printf '%s' "$self") ;;
esac
if [ -f "$self" ]; then
  self_dir=$(CDPATH= cd -- "$(dirname "$self")" && pwd)
  self_path=$self_dir/$(basename "$self")
else
  self_path=
fi
# A PATH symlink to the installed shim is the same file. cp then fails with "are the same file".
if [ "$self_path" != "$installed" ] && { [ -z "$self_path" ] || [ ! -e "$installed" ] || [ ! "$self_path" -ef "$installed" ]; }; then
  mkdir -p "$home/bin"
  if script_file "$self_path"; then
    cp "$self_path" "$installed"
    chmod +x "$installed"
  else
    tmp=$(mktemp)
    fetch "$dist/shim.sha256" "$tmp"
    expected=$(tr -d '[:space:]' < "$tmp")
    rm -f "$tmp"
    fetch "$dist/shim" "$installed"
    verify_sha "$installed" "$expected"
    chmod +x "$installed"
  fi
  if [ "$#" -eq 0 ]; then
    if [ ! -s "$home/default" ]; then
      channel=$(published_channel) || no_default
      write_default "$channel"
    fi
    echo "export PATH=\"\$HOME/.histos/bin:\$PATH\""
    exit 0
  fi
  exec "$installed" "$@"
fi
cmd=${1:-}
case $cmd in
  self)
    shift
    sub=${1:-}
    [ "$sub" = update ] || fail "unknown command 'self ${sub:-}'
did you mean self update?
histos help
histos help self"
    tmp=$(mktemp)
    fetch "$dist/shim.sha256" "$tmp"
    expected=$(tr -d '[:space:]' < "$tmp")
    rm -f "$tmp"
    current=$(hash_of "$installed")
    want=$(printf '%s' "$expected" | tr '[:upper:]' '[:lower:]')
    if [ "$current" = "$want" ]; then exit 0; fi
    next=$home/bin/histos.next
